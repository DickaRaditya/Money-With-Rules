NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Optional. Injected browser wallets work without a WalletConnect project.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local deploy writes src/generated/deployment.json. Override all addresses together for testnet.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_BLOCK=
# Server-side RPC can use a private provider URL; do not prefix with NEXT_PUBLIC_.
SERVER_RPC_URL=http://127.0.0.1:8545
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
